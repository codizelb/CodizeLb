
{
  "installCommand": "rm -rf node_modules && npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": " https://codizelb.onrender.com" },
    { "source": "/uploads/:path*", "destination": " https://codizelb.onrender.com" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}